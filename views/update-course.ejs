<%- include('partials/header') %>
    <%- include('partials/navigation') %>

        <div class="container form-container">
            <div class="card">
                <h2>Kursu Güncelle</h2>

                <form method="POST" action="/courses/<%= course.slug %>?_method=PUT">
                    <div class="form-group">
                        <label for="name">Kurs Adı</label>
                        <input type="text" id="name" name="name" value="<%= course.name %>" required>
                    </div>

                    <div class="form-group">
                        <label for="description">Kurs Açıklaması</label>
                        <textarea id="description" name="description" rows="5"
                            required><%= course.description %></textarea>
                    </div>
                    <div class="form-group" style="margin-bottom: 20px;">
                        <label for="videoID">YouTube Video ID</label>
                        <input type="text" id="videoID" name="videoID" class="form-control"
                            value="<%= course.videoID %>">
                        <small style="color: gray;">Videonun linkindeki 'v=' kısmından sonraki 11 haneli koddur.</small>
                    </div>

                    <button type="submit" class="btn btn-warning w-100">Değişiklikleri Kaydet</button>
                </form>
            </div>
        </div>

        <%- include('partials/footer') %>